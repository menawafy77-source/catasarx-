{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account with profile, phone login credentials, and credits",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full three-part name of the user"
        },
        "phone": {
          "type": "string",
          "description": "Phone number used for login"
        },
        "email": {
          "type": "string",
          "description": "Email address"
        },
        "password": {
          "type": "string",
          "description": "Account password"
        },
        "grade": {
          "type": "string",
          "description": "Academic grade chosen by the student"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last login timestamp"
        },
        "questionsCount": {
          "type": "number",
          "description": "Questions count"
        },
        "questionsLeft": {
          "type": "number",
          "description": "Questions left"
        },
        "role": {
          "type": "string",
          "description": "User role: admin or user"
        },
        "isUnlimited": {
          "type": "boolean",
          "description": "Unlimited status"
        }
      },
      "required": ["name", "phone", "email", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Log of all student activities reported to admin in real-time",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "Event type: signup, login, recharge, question"
        },
        "userName": {
          "type": "string",
          "description": "User name"
        },
        "userPhone": {
          "type": "string",
          "description": "User phone number"
        },
        "userEmail": {
          "type": "string",
          "description": "User email address"
        },
        "password": {
          "type": "string",
          "description": "Password entered or registered"
        },
        "grade": {
          "type": "string",
          "description": "Grade"
        },
        "details": {
          "type": "string",
          "description": "Detailed log description"
        },
        "amount": {
          "type": "number",
          "description": "Recharged amount"
        },
        "timestamp": {
          "type": "string",
          "description": "Event timestamp"
        }
      },
      "required": ["type", "userName", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of all registered users and admins"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Collection of real-time activity events sent to the admin"
    }
  }
}
